{
  "name": "slate-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Slate: tenants, landlords and trades on one record, rating each other fairly (demo)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
